{
  "name": "Contact",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name of the contact"
    },
    "last_name": {
      "type": "string",
      "description": "Last name of the contact"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "company": {
      "type": "string",
      "description": "Current company or organization"
    },
    "role": {
      "type": "string",
      "description": "Job title or role"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "how_we_met": {
      "type": "string",
      "description": "How you connected with this person"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "Birthday for reminder purposes"
    },
    "notes": {
      "type": "string",
      "description": "Personal notes about this contact"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization (e.g., recruiter, mentor, peer)"
    },
    "occasions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom occasions this contact celebrates (e.g., Diwali, Lunar New Year)"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date",
      "description": "When you last reached out"
    },
    "check_in_frequency": {
      "type": "number",
      "description": "Check-in frequency value"
    },
    "check_in_unit": {
      "type": "string",
      "enum": [
        "days",
        "weeks",
        "months",
        "years"
      ],
      "description": "Unit for check-in frequency"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    }
  },
  "required": [
    "first_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
